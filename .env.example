# notion-mcp-server configuration — copy to ".env" or export in your shell.
# NEVER commit a real NOTION_TOKEN. The token is read from the environment only.

# Data mode: "sample" (bundled fake workspace, zero credentials) or "notion" (real API).
MCP_DATA_MODE=sample

# --- Notion mode only -------------------------------------------------------
# Create an internal integration at https://www.notion.so/my-integrations,
# share the target database(s) with it, then set its secret here:
# NOTION_TOKEN=ntn_replace_with_your_integration_secret

# Allowlist: comma-separated Notion database ids the server may touch.
# This is the user's real "Project Tracker" database in the workspace
# "sravanthipanga51's Space" (database page id below; its data source id is
# 100ea1e7-5511-4cf5-a3d2-5e75f96d6a8b — the Notion API queries the data source):
# ALLOWED_DATABASE_IDS=640ec0f6-1ce5-45bf-9420-99898c9f6d13

# Allowlist: comma-separated standalone page ids the server may read
# (rows of allowlisted databases are reachable without being listed here):
# ALLOWED_PAGE_IDS=

# Optional: also append audit JSON lines to this file (always written to stderr):
# MCP_AUDIT_LOG_PATH=logs/audit.log
